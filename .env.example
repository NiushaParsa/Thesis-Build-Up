# OpenAI embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# Qdrant: set QDRANT_URL, or leave it blank and use host/ports.
QDRANT_URL=
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Collections
PAPER_CHUNK_COLLECTION=PaperChunk
PAPER_QUESTION_COLLECTION=PaperQuestion
PAPER_EVIDENCE_COLLECTION=PaperEvidence
RETRIEVAL_EVALUATION_COLLECTION=RetrievalEvaluation
ROUTER_DATASET_COLLECTION=RouterDataset

# Chunking and metrics
CHUNK_SIZES=10,20,40,80,160
TOKENIZER_NAME=gpt2
RETRIEVAL_TOP_K=5
MIXED_DEDUP_OVERLAP_THRESHOLD=0.8
MIXED_DEDUP_CANDIDATE_MULTIPLIER=10
ROUTER_LABEL_TIE_EPSILON=1e-6

# Outputs and optional persistence
JSON_OUTPUT=false
JSON_OUTPUT_DIR=json_output
EVALUATION_OUTPUT_DIR=outputs
EVALUATION_UPSERT_BATCH_SIZE=100
PERSIST_EVALUATIONS=false
PERSIST_ROUTER_DATASET=false
